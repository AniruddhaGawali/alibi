# Copy to .env and fill in. Never commit real secrets.

# --- required by the API
POSTGRES_URI=postgres://postgres:password@localhost:5432/alibi?sslmode=disable
MONGO_URI=mongodb://localhost:27017
REDIS_URI=redis://localhost:6379
# at least 32 random characters, e.g. `openssl rand -hex 32`. Make treats "#" as a comment, so keep it hex.
JWT_SECRET=

# --- image storage (Supabase Storage). Optional for the API: when SUPABASE_URL is
# empty, custom avatar uploads are disabled. Required by `make assets-upload`.
# The service-role key bypasses row-level security: server-side only, never in
# the frontend or in git.
# https://<project-ref>.supabase.co (http:// is only accepted for localhost)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=alibi-assets

# --- required by the email worker (go run ./cmd/worker)
BREVO_SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS, 465 = implicit TLS
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# verified sender; defaults to BREVO_SMTP_USER
EMAIL_FROM=

# --- optional (defaults shown)
# HTTP_ADDR=:8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # browser origins allowed to call the API
# HTTP_WRITE_TIMEOUT_SECONDS=120
# MIGRATE_ON_START=true
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_HOURS=168
# OTP_TTL_MINUTES=10
# OTP_COOLDOWN_SECONDS=60        # gap between codes sent to one email
# OTP_EMAIL_DAILY_MAX=5          # codes per email per 24h
# OTP_IP_MAX=10                  # codes per client IP ...
# OTP_IP_WINDOW_MINUTES=15       # ... per this window
# OTP_MAX_ATTEMPTS=5
# AUTH_IP_MAX=60                 # signup/OTP/login/refresh requests per client IP ...
# AUTH_IP_WINDOW_MINUTES=15      # ... per this window
# LOGIN_MAX_FAILURES=5           # wrong passwords per email before login locks (doubling lockout)
# BCRYPT_WORKERS=0               # max concurrent bcrypt operations; 0 = number of CPUs
# Peers whose X-Forwarded-For / X-Real-IP are believed. Default is loopback only.
# In production set this to your reverse proxy / load balancer addresses; do NOT
# add Docker's private ranges (172.16.0.0/12): with published ports every client
# arrives from the bridge gateway and could then forge its own IP. "none" = never.
# TRUSTED_PROXIES=127.0.0.0/8,::1/128
# WORKER_CONCURRENCY=4           # parallel email consumers per worker process
# WORKER_HTTP_ADDR=:8081         # worker GET /health
# WORKER_MONITOR_SECONDS=30      # how often queue depths are logged
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OLLAMA_HOST=http://localhost:11434
# OPENROUTER_API_KEY=            # interrogations; without it the interrogate endpoint answers 503
# LLM_TIMEOUT_SECONDS=20         # one model call; on timeout the token is refunded
# DAILY_TOKENS=10                # every balance is reset to this once a day (new accounts start with it); 0-10, nobody can hold more than 10
# TOKEN_RESET_CRON=0 0 * * *     # when the reset runs (5-field cron)
# TOKEN_RESET_TIMEZONE=UTC       # IANA zone for TOKEN_RESET_CRON, e.g. Asia/Kolkata
# MONGO_DATABASE=alibi           # MongoDB database for chat_messages
# CHAT_WORKER_CONCURRENCY=2      # chat storage consumers inside the API
