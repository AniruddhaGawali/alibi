# Copy to frontend/.env.local and fill in.
# VITE_API_URL=http://localhost:8080
# Public base URL of the image bucket. Unset = images from frontend/public.
# VITE_ASSET_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/alibi-assets
# Production (Vercel): set both in the project's Environment Variables.
# VITE_API_URL=https://alibi-backend.onrender.com
